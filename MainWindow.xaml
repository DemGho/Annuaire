<Window x:Class="Annuaire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annuaire" Height="450" Width="900">
	<DockPanel Margin="10">
		<Button DockPanel.Dock="Top" Content="Charger les employés"
                Width="180" HorizontalAlignment="Left" Margin="0,0,0,10"
                Click="LoadButton_Click"/>
		<ListView x:Name="EmployeesList">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="Prénom" DisplayMemberBinding="{Binding FirstName}" Width="110"/>
					<GridViewColumn Header="Nom" DisplayMemberBinding="{Binding LastName}" Width="110"/>
					<GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="230"/>
					<GridViewColumn Header="Téléphone" DisplayMemberBinding="{Binding Phone}" Width="110"/>
					<GridViewColumn Header="Département" DisplayMemberBinding="{Binding Department.Name}" Width="130"/>
					<GridViewColumn Header="Ville" DisplayMemberBinding="{Binding Location.City}" Width="110"/>
				</GridView>
			</ListView.View>
		</ListView>
	</DockPanel>
</Window>